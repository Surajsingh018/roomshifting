# Copy to .env and set private, local values. Never commit .env.
ROOMSHIFT_APP_ENV=local
ROOMSHIFT_DEBUG=0
ROOMSHIFT_BASE_URL=http://localhost/roomshift
ROOMSHIFT_DB_HOST=localhost
ROOMSHIFT_DB_NAME=roomshift_db
ROOMSHIFT_DB_USER=root
ROOMSHIFT_DB_PASS=
ROOMSHIFT_DB_PORT=3306
ROOMSHIFT_SESSION_NAME=ROOMSHIFTSESSID
ROOMSHIFT_SESSION_SECURE=0
ROOMSHIFT_RATE_LIMIT_KEY=replace_with_a_random_32_byte_secret
ROOMSHIFT_PUBLIC_TOKEN_KEY=replace_with_a_different_random_32_byte_secret
ROOMSHIFT_PAYMENT_PROVIDER=
ROOMSHIFT_PAYMENT_WEBHOOK_SECRET=
ROOMSHIFT_NOTIFICATION_PROVIDER=
